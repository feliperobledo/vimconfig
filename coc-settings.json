{
  "tsserver.npm": "/Users/feliperobledo/.nvm/versions/node/v22.14.0/bin/npm",
  "tsserver.log": "verbose",
  "tsserver.trace.server": "verbose",
  "tsserver.maxTsServerMemory": 4096,
  "typescript.showUnused": true,
  "typescript.autoClosingTags": true,

  "typescript.suggest.autoImports": true,

  "diagnostic.checkCurrentLine": true,

  "eslint.run": "onSave",
  "eslint.autoFixOnSave": false,
  "eslint.options": {
      "overrideConfigFile": ".eslintrc.js",
  },

  "python.jediEnabled": true,
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": false,
  "python.linting.pep8Enabled": true,

  "coc.preferences.jumpCommand": "tab drop",

  "[typescript]": {
    "coc.preferences.formatOnSave": true
  },
  "[typescriptreact]": {
    "coc.preferences.formatOnSave": true
  },
  "[javascript]": {
    "coc.preferences.formatOnSave": true
  },
  "[javascriptreact]": {
    "coc.preferences.formatOnSave": true
  },
  "[css]": {
    "coc.preferences.formatOnSave": true
  },
  "[markdown]": {
    "coc.preferences.formatOnSave": true
  },

  "languageserver": {
    "ccls": {
      "command": "ccls",
      "filetypes": ["c", "cpp", "objc", "objcpp"],
      "rootPatterns": ["compile_commands.json"],
      "initializationOptions": {
        "cache": {
          "directory": "/tmp/ccls"
        },
        "clang": {
          "resourceDir": "/Library/Developer/CommandLineTools/usr/lib/clang/12.0.0",
          "extraArgs": [
            "-isystem",
            "/Library/Developer/CommandLineTools/usr/include/c++/v1",
            "-I",
            "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include/"
          ]
        }
      }
    },
    "marko": {
      "command": "/Users/frobledosalcedo/.nvm/versions/node/v14.18.1/lib/node_modules/@marko/language-server/dist/bin.js",
      "args": ["--node-ipc"],
      "filetypes": ["marko"],
      "trace.server": "verbose"
    }
  },

  "highlight.disableLanguages": ["c", "c++"]
}
